# ========== 必需配置 ==========
# 站点完整 URL(带协议),用于 SEO canonical、sitemap、分享海报等
# 运行时环境变量,通过 docker run -e SITE_URL=https://your-domain.com 传入
SITE_URL=https://your-domain.com

# ========== 可选:分析追踪 ==========
# Google Analytics ID(不设置则不加载 GA)
# GA_ID=G-XXXXXXXXXX

# ========== 可选:AI 服务端默认 Key ==========
# 以下 Key 均为可选,不配置时用户需在前端设置页面填入自己的 API Key
# ZenMux LLM 网关
# ZENMUX_API_KEY=

# Tokendance LLM 网关
# TOKENDANCE_API_KEY=
# TOKENDANCE_BASE_URL=https://tokendance.agent-universe.cn/gateway/v1

# 阿里云 DashScope
# DASHSCOPE_API_KEY=

# ========== 可选:MiniMax TTS 语音合成 ==========
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# MINIMAX_API_BASE_URL=https://api.minimaxi.com
# MINIMAX_TTS_MODEL=speech-01-turbo
